# Copiar este archivo como database/.env y cambiar la clave.
# database/.env NO se sube a GitHub.

POSTGRES_DB=taxi_predictions
POSTGRES_USER=taxi_app
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5432

# Host de la base visto desde la API:
#   localhost -> si la API corre en tu máquina
#   db        -> si la API corre como otro servicio del mismo docker-compose
DB_HOST=localhost
